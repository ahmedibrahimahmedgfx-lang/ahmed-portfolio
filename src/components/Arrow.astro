---
interface Props { dir?: 'right' | 'ne' | 'down' | 'replay'; class?: string }
const { dir = 'right', class: cls = '' } = Astro.props;
---
{dir === 'replay' ? (
  <svg class={`arrow ${cls}`} viewBox="0 0 16 16" aria-hidden="true" width="0.9em" height="0.9em"><path d="M13 8a5 5 0 1 1-1.5-3.6" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M11.8 1.6v3.3H8.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
) : (
  <svg class={`arrow arrow--${dir} ${cls}`} viewBox="0 0 16 16" aria-hidden="true" width="0.9em" height="0.9em">
    <path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
  </svg>
)}
