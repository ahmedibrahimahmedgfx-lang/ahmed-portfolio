---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Blank tape / Ahmed Ibrahim">
  <section class="opening wrap" data-section data-track="SIDE B" data-label="BLANK TAPE">
    <div class="meta-block meta"><div class="a">Error / 404</div><div class="c">00:00:00:00</div></div>
    <h1 class="name display" style="padding-bottom:calc(var(--hud) + 60px)"><span class="line l1">Blank</span><span class="line l2 dim">tape.</span></h1>
    <a class="play meta" href="/" data-cursor="REWIND"><span class="label">Rewind to start</span><span class="shaft"></span><span class="head"><Arrow /></span></a>
  </section>
</Base>
