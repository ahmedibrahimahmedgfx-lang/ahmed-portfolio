---
import Arrow from './Arrow.astro';
import { SITE } from '../data/site';
const links = [
  { k: 'Email', v: SITE.email, href: `mailto:${SITE.email}`, cursor: 'CONNECT →', ext: false },
  { k: 'WhatsApp', v: SITE.whatsappLabel, href: SITE.whatsapp, cursor: 'OPEN ↗', ext: true },
  { k: 'Behance', v: SITE.behanceLabel, href: SITE.behance, cursor: 'OPEN ↗', ext: true },
  { k: 'LinkedIn', v: SITE.linkedinLabel, href: SITE.linkedin, cursor: 'OPEN ↗', ext: true },
];
---
<section class="closing wrap" id="contact" data-section data-track="SIDE B" data-label="END OF TAPE" aria-labelledby="close-h">
  <div class="tt" data-tt>
    <div class="tt-stage">
      <p class="tt-st tt-a display dim" data-tt-a>
        <span class="m"><span class="w" data-tt-w>The tools</span></span>
        <span class="m"><span class="w" data-tt-w>evolve.</span></span>
      </p>
      <p class="tt-st tt-b display" data-tt-b>
        <span class="m"><span class="w" data-tt-w>The thinking</span></span>
        <span class="m"><span class="w acid" data-tt-w data-tt-accent>stays.</span></span>
      </p>
    </div>
  </div>
  <p class="ends display" data-reveal>Tape ends.<br /><span class="dim">The work doesn’t.</span></p>

  <h2 class="lets display" id="close-h" data-reveal><span>Let’s create</span><br /><span class="acid">something.</span></h2>

  <div class="contact" data-contact>
    <div class="who">
      <span class="meta">Ahmed Ibrahim</span>
      <span class="meta quiet">Strategic Brand Designer /<br />Art Director</span>
      <p class="body" style="margin-top:14px">Available for brand identity, art direction and selected creative collaborations.</p>
    </div>
    <ul>
      <span class="tape-follow" data-follow aria-hidden="true"></span>
      {links.map((l) => (
        <li>
          <a href={l.href} data-contact-link data-cursor={l.cursor} {...(l.ext ? { target: '_blank', rel: 'noopener' } : {})}>
            <span class="k meta">{l.k}</span>
            <span class="v">{l.v}</span>
            <span class="meta">{l.ext ? <Arrow dir="ne" /> : <Arrow />}</span>
          </a>
          <span class="line" aria-hidden="true"></span>
        </li>
      ))}
    </ul>
  </div>

  <div class="end">
    <div class="end-msg">
      <p class="thanks display">Thanks for listening.</p>
      <p class="mono quiet" style="margin-top:14px">End of tape / 2026</p>
    </div>
    <!-- slot = layout size and grid position; perspective = 3D space; object = the only thing that moves -->
    <div class="cassette-slot" aria-hidden="true" data-cassette>
      <div class="cassette-perspective">
        <div class="cassette-object" data-cas-tilt>
          <picture>
            <source type="image/avif" srcset="/media/img/closing-cassette-master-720.avif 720w, /media/img/closing-cassette-master-1100.avif 1100w" sizes="(max-width: 760px) 68vw, 340px" />
            <img class="cas-art" src="/media/img/closing-cassette-master-720.webp" srcset="/media/img/closing-cassette-master-720.webp 720w, /media/img/closing-cassette-master-1100.webp 1100w" sizes="(max-width: 760px) 68vw, 340px" width="1100" height="1790" alt="" loading="lazy" decoding="async" />
          </picture>
          <span class="cas-glare"></span>
        </div>
      </div>
    </div>
    <a class="replay mono" href="#top" data-replay data-cursor="REWIND">Replay <svg class="arrow" viewBox="0 0 16 16" width="0.9em" height="0.9em" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.5-3.6" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M11.8 1.6v3.3H8.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></a>
  </div>
</section>
