---
/** The cassette's hidden track: a doorway to the playable portfolio at /play. Sits after the work, before the booking section. */
import Arrow from './Arrow.astro';
---
<section class="hidden-track wrap" id="play" data-section data-track="HIDDEN TRACK" data-label="CAIRO, UNBRANDED" aria-labelledby="ht-h">
  <div class="row meta">
    <span class="num">Hidden track</span>
    <span class="quiet">Side B / a playable portfolio</span>
  </div>
  <div class="ht-grid">
    <div class="ht-copy">
      <h2 class="display" id="ht-h" data-reveal>Cairo,<br /><span class="acid">unbranded.</span></h2>
      <p class="body" data-reveal>The whole portfolio as a small game. Walk a grey Cairo, find the work, and give the city its colour back.</p>
      <a class="sess-all meta" href="/play" data-astro-reload data-cursor="PLAY →">
        Play the game <span class="shaft" aria-hidden="true"></span><span class="arrow"><Arrow /></span>
      </a>
    </div>
    <a class="ht-still" href="/play" data-astro-reload data-cursor="PLAY →" aria-label="Play Cairo, unbranded">
      <img src="/media/play-still.webp" width="1600" height="1000" loading="lazy" decoding="async" alt="A voxel Cairo street from the game: shops, a kiosk, taxis and people" />
      <span class="ht-tag mono">Press play</span>
    </a>
  </div>
</section>

<style>
  .hidden-track { padding-block: clamp(80px, 12vw, 200px); }
  .hidden-track .row { display: flex; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--rule); padding-bottom: 14px; }
  .hidden-track .row .num { color: var(--acid); }
  .ht-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 70px); align-items: end; margin-top: clamp(28px, 4vw, 60px); }
  .ht-copy h2 { font-size: clamp(2.4rem, 5.2vw, 6.4rem); }
  .ht-copy .body { max-width: 34ch; margin: clamp(18px, 2vw, 28px) 0 0; }
  .ht-copy .sess-all { margin-top: clamp(22px, 3vw, 40px); }
  .ht-still { position: relative; display: block; overflow: hidden; background: var(--ink-2, #121016); }
  .ht-still img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; filter: grayscale(1); transition: filter 0.7s var(--ease, ease), transform 0.9s var(--ease, ease); }
  .ht-still:hover img, .ht-still:focus-visible img { filter: grayscale(0); transform: scale(1.03); }
  .ht-tag { position: absolute; left: 12px; bottom: 12px; background: var(--acid); color: var(--ink); padding: 7px 10px; }
  @media (max-width: 820px) {
    .ht-grid { grid-template-columns: 1fr; }
    .ht-copy h2 { font-size: 12vw; }
    .ht-still img { filter: grayscale(0); }
  }
</style>
