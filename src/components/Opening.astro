---
import Arrow from './Arrow.astro';
---
<section class="opening wrap" id="top" data-section data-track="SIDE A" data-label="OPENING" aria-label="Ahmed Ibrahim, Selected Recordings">
  <div class="meta-block meta">
    <div class="a">Ahmed Ibrahim<br /><span class="quiet">Strategic Brand Designer /<br />Art Director</span></div>
    <div class="b">Selected<br />Recordings<br /><span class="quiet">A visual mixtape / 2019—2026</span></div>
    <div class="c quiet">Format / Brand design<br />Edition / 01<br />Archive / Selected work<br />Running time / 07+ years</div>
  </div>
  <h1 class="name display" aria-label="Ahmed Ibrahim">
    <span class="line l1" data-name-line="1" aria-hidden="true"><span class="li">Ahmed</span></span>
    <span class="line l2" data-name-line="2" aria-hidden="true"><span class="li">Ibrahim</span></span>
  </h1>
  <p class="side-note meta quiet">A visual archive of<br />identities, systems, ideas.</p>
  <a class="play meta" href="#profile" data-press-play data-cursor="PLAY">
    <span class="label">Press play</span>
    <span class="shaft" data-play-shaft></span>
    <span class="head" data-play-head><Arrow /></span>
  </a>
</section>
