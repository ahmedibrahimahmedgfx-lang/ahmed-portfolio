---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import Arrow from '../components/Arrow.astro';
import { SITE, TRACKS } from '../data/site';
import { BRAND, ART } from '../data/projects';
import { previewSrc } from '../lib/media';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** label shown at the left of the tape bar until sections take over */
  side?: string;
  pageClass?: string;
  jsonLd?: Record<string, unknown>;
}
const { title = SITE.title, description = SITE.description, image = '/og.jpg', side = 'SIDE A', pageClass = '', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: 'Strategic Brand Designer / Art Director',
  email: `mailto:${SITE.email}`,
  url: Astro.site?.toString(),
  sameAs: [SITE.behance, SITE.linkedin],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b090e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ahmed Ibrahim / Selected Recordings" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href="/fonts/albertus-medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-wdth-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? person)} />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('has-cursor');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class={pageClass} data-side={side}>
    <a class="skip meta" href="#main">Skip to content</a>

    <header class="hud-top meta" transition:persist="hud-top">
      <a class="brand" href="/" aria-label="Ahmed Ibrahim, home" data-cursor="HOME">
        <Mark />
        <span>Strategic brand designer /<br />Art director</span>
      </a>
      <div class="right">
        <span class="hide-s">A visual mixtape /<br />2019—2026</span>
        <button class="tl-btn meta" type="button" data-nav-open aria-expanded="false" aria-controls="tracklist-nav" data-cursor="TRACKLIST">
          <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span> Tracklist
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <div class="tape-bar" data-state="idle" transition:persist="tape-bar" aria-hidden="true">
      <div class="now mono"><b data-tape-track>{side}</b><span data-tape-label></span></div>
      <div class="track-line"><span class="base"></span><span class="prog" data-tape-prog></span><span data-tape-ticks></span></div>
      <div class="tc mono" data-tape-tc>00:00:00</div>
    </div>

    <div class="nav-overlay" id="tracklist-nav" role="dialog" aria-modal="true" aria-label="Tracklist" hidden transition:persist="nav-overlay">
      <div class="bar meta">
        <span>Selected recordings / 2019—2026</span>
        <button type="button" class="meta" data-nav-close data-cursor="CLOSE">Close</button>
      </div>
      <nav class="tracklist" aria-label="Tracklist">
        <ol>
          {TRACKS.map((t) => (
            <li>
              <a href={`/#${t.id}`} data-nav-link data-preview={t.preview} data-preview-src={previewSrc(t.preview)} data-cursor={`TRACK ${t.n}`}>
                <span class="t-n mono">Track {t.n}</span>
                <span class="t-name">{t.name}</span>
                <span class="t-meta meta quiet">{t.meta}</span>
              </a>
              {t.n === '01' && (
                <div class="projects meta">{BRAND.map((p) => <a href={`/work/${p.slug}`} data-nav-link>{p.title}</a>)}</div>
              )}
              {t.n === '03' && (
                <div class="projects meta">{ART.map((p) => <a href={`/work/${p.slug}`} data-nav-link>{p.title}</a>)}</div>
              )}
            </li>
          ))}
        </ol>
      </nav>
      <div class="sub meta quiet">
        <a href={`mailto:${SITE.email}`} data-cursor="CONNECT">{SITE.email}</a>
        <a href="/#contact" data-nav-link>Contact <Arrow /></a>
      </div>
    </div>

    <div class="preview" aria-hidden="true" transition:persist="preview">
      <div class="frame"><img alt="" data-preview-img decoding="async" /></div>
      <div class="cap mono micro"><span data-preview-cap></span><span data-preview-n></span></div>
    </div>

    <div class="theater" role="dialog" aria-modal="true" aria-labelledby="theater-title" hidden transition:persist="theater">
      <div class="bar meta">
        <span id="theater-title" data-theater-title>Film</span>
        <button type="button" class="meta ctl" data-theater-close data-cursor="CLOSE">Close <span aria-hidden="true">×</span></button>
      </div>
      <div class="screen" data-theater-screen>
        <div class="frame" data-theater-frame>
          <div class="surface" data-cursor="PLAY / PAUSE" data-scrub-surface>
            <video playsinline preload="none" data-theater-video></video>
          </div>
          <div class="scrub mono">
            <button type="button" class="ctl mono" data-theater-toggle aria-label="Pause">Pause</button>
            <span class="t-cur" data-theater-cur>00:00</span>
            <div class="line" data-theater-line role="slider" aria-label="Seek" tabindex="0" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="00:00"><span class="buf" data-theater-buf></span><span class="fill" data-theater-fill></span><span class="knob" data-theater-knob></span></div>
            <span class="t-dur" data-theater-dur>00:00</span>
            <button type="button" class="ctl mono" data-theater-mute aria-pressed="false">Sound on</button>
          </div>
        </div>
      </div>
    </div>

    <div class="cursor" aria-hidden="true" transition:persist="cursor"><span class="dot"></span><span class="label" data-cursor-label></span></div>

    <script>
      import { boot } from '../scripts/app';
      boot();
    </script>
  </body>
</html>
