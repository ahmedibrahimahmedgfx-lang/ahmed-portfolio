---
import Img from './Img.astro';
import TrackHead from './TrackHead.astro';
import { TYPE_WORKS } from '../data/site';
import { img } from '../lib/media';
---
<TrackHead n="04" />
<div class="typography" data-section data-track="TRACK 04" data-label="TYPOGRAPHY & POSTERS">
  <div class="type-intro wrap">
    <p class="statement display" data-reveal><span class="acid">Turning feeling</span><br /><span class="dim">into form.</span></p>
    <div class="flow meta" data-reveal>
      <span><b>Feeling</b><span class="mono quiet">01</span></span>
      <span><b>Letterform</b><span class="mono quiet">02</span></span>
      <span><b>Composition</b><span class="mono quiet">03</span></span>
    </div>
  </div>

  {TYPE_WORKS.map((w, i) => (
    <article class="type-work" aria-labelledby={`tw-${w.slug}`}>
      {w.letter ? (
        <div class={`tw-seq${i % 2 ? ' tw-seq--flip' : ''}`} data-type-seq>
          <div class="tw-stage">
            <div class="tw-meta mono micro wrap">
              <span>04.{w.n} / {w.title}</span>
              <span class="quiet"><span data-tw-phase>Letterform</span> <span class="tw-step" data-tw-step>01 / 03</span></span>
            </div>
            <div class="tw-letter" data-tw-letter data-ratio={img(w.letter).ratio} style={`--r:${img(w.letter).ratio}`}>
              <Img id={w.letter} alt={`${w.title} lettering`} sizes="(max-width:760px) 92vw, 46vw" fit="contain" />
            </div>
            <div class="tw-posters" data-tw-posters data-cursor="EXPLORE">
              {w.images.map((id, j) => (
                <figure class="tw-poster" data-tw-poster data-ratio={img(id).ratio} style={`--r:${img(id).ratio}`}>
                  <Img id={id} alt={`${w.title}, poster ${j + 1}`} sizes="(max-width:760px) 92vw, 44vw" fit="contain" />
                </figure>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <div class="tw-single wrap" data-cursor="EXPLORE">
          <div class="tw-single-frame" data-mask style={`--r:${img(w.images[0]).ratio}`}>
            <Img id={w.images[0]} alt={`${w.title}: Arabic lettering seen through a lens with a running deer`} sizes="100vw" fit="contain" />
          </div>
        </div>
      )}
      <div class="cap wrap">
        <div class="t">
          <span class="mono micro quiet">04.{w.n}</span>
          <h3 id={`tw-${w.slug}`}>{w.title}</h3>
          <p class="meta quiet" style="margin:10px 0 0">{w.kind}</p>
        </div>
        <p class="body" data-reveal>{w.text}</p>
      </div>
    </article>
  ))}
</div>
