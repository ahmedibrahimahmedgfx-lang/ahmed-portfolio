---
import TrackHead from './TrackHead.astro';
import Arrow from './Arrow.astro';
import { FILMS } from '../data/site';
import { poster, video } from '../lib/media';
const F = FILMS.map((f) => ({ ...f, p: poster(f.poster), loops: video(f.loop), full: video(f.film)[0], stillP: f.stills.map(poster) }));
const [q, mini, mac] = F;
const sources = (f: (typeof F)[number]) => JSON.stringify(f.loops.map((l) => ({ size: l.size, mp4: l.mp4, webm: l.webm })));
---
<TrackHead n="05" />
<div class="rd" data-section data-track="TRACK 05" data-label="VISUAL R&D">
  <!-- 01 / THE QUESTION: quiet, wide, slow -->
  <article class="film film--quiet wrap" aria-labelledby="f-q">
    <button class="player" type="button" data-loop={sources(q)} data-film={q.full.mp4} data-film-title={`05.01 / ${q.title}`} data-cursor="PLAY" aria-label={`Play ${q.title}, full film with sound`}>
      <picture><source type="image/avif" srcset={q.p.avif} /><img src={q.p.webp} alt="" width={q.p.width} height={q.p.height} loading="lazy" decoding="async" /></picture>
      <video muted loop playsinline preload="none" aria-hidden="true"></video>
      <span class="pp mono micro"><i></i>Rec. / preview</span>
    </button>
    <div class="info">
      <h3 class="display" id="f-q"><span class="mono quiet" style="display:block;font-size:var(--t-meta);margin-bottom:12px">05.01</span>{q.title}</h3>
      <div class="side">
        <span class="meta">{q.kind}</span>
        <p class="body">{q.text}</p>
        <button class="watch meta" type="button" data-film={q.full.mp4} data-film-title={`05.01 / ${q.title}`} data-cursor="PLAY"><span class="u">Watch the film</span> <Arrow dir="ne" /></button>
      </div>
    </div>
    <div class="stills">
      {q.stillP.map((s) => <picture data-reveal><source type="image/avif" srcset={s.avif} /><img src={s.webp} alt="" width={s.width} height={s.height} loading="lazy" decoding="async" /></picture>)}
    </div>
  </article>

  <!-- 02 / MINI SHOWREEL: fast, offset, counting -->
  <article class="film film--fast wrap" aria-labelledby="f-m">
    <div class="layout">
      <div class="counter">
        <span class="mono quiet">Frame</span>
        <span class="frames" data-frame-counter>0000</span>
        <span class="mono micro quiet">30 fps / 00:15</span>
      </div>
      <button class="player" type="button" data-loop={sources(mini)} data-film={mini.full.mp4} data-film-title={`05.02 / ${mini.title}`} data-counter data-cursor="PLAY" aria-label={`Play ${mini.title}, full film with sound`}>
        <picture><source type="image/avif" srcset={mini.p.avif} /><img src={mini.p.webp} alt="" width={mini.p.width} height={mini.p.height} loading="lazy" decoding="async" /></picture>
        <video muted loop playsinline preload="none" aria-hidden="true"></video>
        <span class="pp mono micro"><i></i>Rec. / preview</span>
      </button>
    </div>
    <div class="info">
      <h3 class="display" id="f-m"><span class="mono quiet" style="display:block;font-size:var(--t-meta);margin-bottom:12px">05.02</span>{mini.title}</h3>
      <div class="side">
        <span class="meta">{mini.kind}</span>
        <p class="body">{mini.text}</p>
        <button class="watch meta" type="button" data-film={mini.full.mp4} data-film-title={`05.02 / ${mini.title}`} data-cursor="PLAY"><span class="u">Watch the film</span> <Arrow dir="ne" /></button>
      </div>
    </div>
  </article>

  <!-- 03 / MAC APP FILM: precise, vertical, centred between spec columns -->
  <article class="film film--precise wrap" aria-labelledby="f-c">
    <div class="layout">
      <div class="spec l">
        <span class="mono quiet">05.03</span>
        <h3 class="display" id="f-c" style="font-size:var(--t-m)">{mac.title}</h3>
        <span class="meta">{mac.kind}</span>
      </div>
      <button class="player" type="button" data-loop={sources(mac)} data-film={mac.full.mp4} data-film-title={`05.03 / ${mac.title}`} data-cursor="PLAY" aria-label={`Play ${mac.title}, full film with sound`}>
        <picture><source type="image/avif" srcset={mac.p.avif} /><img src={mac.p.webp} alt="" width={mac.p.width} height={mac.p.height} loading="lazy" decoding="async" /></picture>
        <video muted loop playsinline preload="none" aria-hidden="true"></video>
        <span class="pp mono micro"><i></i>Rec. / preview</span>
      </button>
      <div class="spec r">
        <p class="body">{mac.text}</p>
        <dl class="mono micro">
          <dt>Format</dt><dd>9:16 / 1080 × 1920</dd>
          <dt>Running time</dt><dd>00:16</dd>
        </dl>
        <button class="watch meta" type="button" data-film={mac.full.mp4} data-film-title={`05.03 / ${mac.title}`} data-cursor="PLAY"><span class="u">Watch the film</span> <Arrow dir="ne" /></button>
      </div>
    </div>
  </article>
</div>
